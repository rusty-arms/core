{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/cleanroom-guard.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "WebFetch(domain:archive.org)"
    ]
  }
}
